{
  "info": {
    "name": "Jueves — Exception Filters",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3101"
    }
  ],
  "item": [
    {
      "name": "pacientes",
      "item": [
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/pacientes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba filtro\",\n  \"apellido\": \"Temporal\",\n  \"email\": \"{{pacientesEmail}}\",\n  \"fechaNacimiento\": \"2000-01-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('pacientesEmail', 'filtro-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('pacientesId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Correo duplicado",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/pacientes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba filtro\",\n  \"apellido\": \"Temporal\",\n  \"email\": \"{{pacientesEmail}}\",\n  \"fechaNacimiento\": \"2000-01-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/pacientes/{{pacientesId}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar inexistente",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/pacientes/{{pacientesId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No existe\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar inexistente",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pacientes/{{pacientesId}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },

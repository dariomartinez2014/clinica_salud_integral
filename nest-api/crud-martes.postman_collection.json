{
  "info": {
    "name": "Clínica — CRUD del martes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "especialidadId",
      "value": "1"
    },
    {
      "key": "pacienteId",
      "value": ""
    },
    {
      "key": "medicoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "pacientes",
      "item": [
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pacientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba\",\n  \"apellido\": \"Martes\",\n  \"email\": \"paciente-{{$guid}}@example.com\",\n  \"telefono\": \"55550000\",\n  \"fechaNacimiento\": \"2000-01-15T00:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('pacienteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pacientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pacientes/{{pacienteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar parcialmente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pacientes/{{pacienteId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"55551111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/pacientes/{{pacienteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar 404 después de eliminar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pacientes/{{pacienteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },

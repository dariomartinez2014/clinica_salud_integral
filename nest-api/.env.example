# Plantilla: reemplaza los marcadores localmente. Nunca publiques tu .env.
# Base PostgreSQL de práctica con el esquema del proyecto ya aplicado.
DATABASE_URL="postgresql://postgres:CAMBIAR@localhost:5432/clinica_salud_integral?schema=public"
# Opcional; entero entre 1 y 65535. Por defecto: 3000.
PORT=3000
# Obligatorio; genera un secreto propio de al menos 32 caracteres.
JWT_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES"

{
  "name": "clinica-salud-integral-nest",
  "version": "0.0.1",
  "description": "Clínica NestJS con CRUD de pacientes y médicos y PrismaService global",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "oxlint src/",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test:e2e": "pnpm run build && node test/crud.e2e.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2",
    "prisma": "^7.10.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  }
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RECEPCIONISTA
  MEDICO
  GERENCIA

  @@map("Rol")
}

enum EstadoCita {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  role      Role     @map("rol")
  createdAt DateTime @default(now())

  @@map("users")
}

model Paciente {
  id              Int      @id @default(autoincrement())
  nombre          String
  apellido        String
  email           String   @unique
  telefono        String?
  fechaNacimiento DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  citas Cita[]

  @@map("pacientes")
}

model Especialidad {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  medicos Medico[]

  @@map("especialidades")
}

model Medico {
  id             Int      @id @default(autoincrement())
  nombre         String
  apellido       String
  email          String   @unique
  telefono       String?
  especialidadId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  especialidad Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Restrict)
  citas        Cita[]

  @@index([especialidadId])
  @@map("medicos")
}

model Cita {
  id         Int        @id @default(autoincrement())
  pacienteId Int
  medicoId   Int
  fecha      DateTime   @db.Timestamptz(3)
  motivo     String?
  estado     EstadoCita @default(PROGRAMADA)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  medico   Medico   @relation(fields: [medicoId], references: [id], onDelete: Restrict)

  @@index([medicoId, fecha])
  @@index([pacienteId, fecha])
  @@index([fecha, estado])
  @@map("citas")
}